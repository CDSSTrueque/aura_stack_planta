# Copiar a .env y cambiar TODAS las contraseñas.
#
# Dos trampas, las dos explicadas en el README (paso 1):
#   1. NO cambiar PG_SUPERUSER a "odoo": choca con el rol que crea
#      initdb/01-roles-y-bases.sh y el init aborta a medias.
#   2. Un "$" dentro de una contraseña se escribe "$$", si no Compose lo
#      interpreta como variable y se come el resto.  Y6$tW9nC4 -> Y6$$tW9nC4
#
# Comprobar con: docker compose config
PG_SUPERUSER=postgres
PG_SUPERPASSWORD=cambiar_esto_1
ODOO_PG_PASSWORD=cambiar_esto_2
NODERED_PG_PASSWORD=cambiar_esto_3
